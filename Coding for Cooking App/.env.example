[TEMPLATE]
OPENAI_API_KEY=your_api_key_here
AI_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=cohere/north-mini-code:free
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
VITE_API_BASE_URL=/api
EMBED_API_KEY=your_embeddings_key_here
EMBED_URL=https://ai.hackclub.com/proxy/v1/embeddings
EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free

# ─── OAuth sign-in (optional — providers stay hidden until configured) ───────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer → Identifiers → Services ID + Sign in with Apple key
APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET is a signed ES256 JWT; set APPLE_KEY_ID + APPLE_KEY_PEM
# and the server signs it automatically, OR paste a pre-signed JWT directly.
APPLE_KEY_ID=
APPLE_KEY_PEM=
# Base URL used to build provider redirect URIs, no trailing slash.
# Local: http://localhost:3001  |  Cloud: https://cooking-app-duc.pages.dev
OAUTH_REDIRECT_BASE=
